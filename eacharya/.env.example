# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard -> Project Settings -> API (URL) and API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Public site URL, used for email redirect links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: Phase 1 needs NO service-role / secret key. Do not add one to client code.
